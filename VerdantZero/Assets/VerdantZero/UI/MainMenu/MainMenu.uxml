<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/VerdantZero/UI/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=dab1087fa4394394d9e848f95bd88bf5&amp;type=3#MainMenu"/>
    <ui:VisualElement name="root-container" class="root-container">
        <!-- Animated background built from the key art (MainMenuBackground.cs). Positions are % of the 1376x768 image -->
        <ui:VisualElement name="background" picking-mode="Ignore" class="background">
            <ui:VisualElement name="bg-stage" picking-mode="Ignore" class="bg-stage">
                <ui:VisualElement picking-mode="Ignore" class="bg-base"/>
                <ui:VisualElement name="bg-smoke" picking-mode="Ignore" class="bg-fill"/>
                <ui:VisualElement name="bg-beam" picking-mode="Ignore" class="bg-beam"/>
                <ui:VisualElement name="bg-impact" picking-mode="Ignore" class="bg-flare bg-impact"/>
                <ui:VisualElement name="bg-drone" picking-mode="Ignore" class="bg-drone">
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--1"/>
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--2"/>
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--3"/>
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--4"/>
                </ui:VisualElement>
                <ui:VisualElement name="bg-logo-glow" picking-mode="Ignore" class="bg-logo-glow"/>
                <ui:VisualElement name="bg-logo" picking-mode="Ignore" class="bg-logo"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="safe-area" picking-mode="Ignore" class="safe-area">
            <ui:VisualElement name="menu" class="menu">
                <!-- The title and tagline come from the background logo -->
                <ui:VisualElement name="VisualElement" class="button-column">
                    <ui:Button text="PLAY" name="btn-play" class="menu-button menu-button--primary"/>
                    <ui:Button text="OPTIONS" name="btn-options" class="menu-button"/>
                    <ui:Button text="CREDITS" name="btn-credits" class="menu-button menu-button--ghost"/>
                    <ui:Button text="QUIT" name="btn-exit" class="menu-button menu-button--ghost"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="v0.1" name="version-label" class="version"/>
        </ui:VisualElement>
        <ui:VisualElement name="options-overlay" class="overlay">
            <ui:VisualElement name="options-panel" class="panel">
                <ui:Label text="OPTIONS" class="panel-title"/>
                <ui:Slider label="Music" name="slider-music" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Slider label="Effects" name="slider-sfx" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:VisualElement class="option-row">
                    <ui:Toggle label="Vibration" name="toggle-vibration" value="true" class="option-toggle option-row__item"/>
                    <ui:Toggle label="Fullscreen" name="toggle-fullscreen" value="true" class="option-toggle option-row__item"/>
                </ui:VisualElement>
                <ui:Toggle label="Fixed joystick" name="toggle-fixed-joystick" value="false" class="option-toggle"/>
                <!-- Pressing cycles through Easy, Normal and Hard -->
                <ui:Button text="DIFFICULTY: NORMAL" name="btn-difficulty" class="menu-button"/>
                <ui:Button text="BACK" name="btn-options-back" class="menu-button menu-button--primary panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Credits and attributions (GDD 9.4) -->
        <ui:VisualElement name="credits-overlay" class="overlay">
            <ui:VisualElement name="credits-panel" class="panel credits-panel">
                <ui:Label text="CREDITS" class="panel-title"/>
                <ui:ScrollView name="credits-scroll" class="credits-scroll" mode="Vertical">
                    <ui:Label text="Design and development" class="credits-heading"/>
                    <ui:Label text="The Verdant Zero Team" class="credits-line"/>
                    <ui:Label text="Verdant-1 Drone" class="credits-heading"/>
                    <ui:Label text="Original model made in Blender" class="credits-line"/>
                    <ui:Label text="City" class="credits-heading"/>
                    <ui:Label text="POLYGON City Pack (Unity Asset Store)" class="credits-line"/>
                    <ui:Label text="Skies" class="credits-heading"/>
                    <ui:Label text="Kloofendal Overcast Pure Sky and Spruit Sunrise" class="credits-line"/>
                    <ui:Label text="Poly Haven (CC0)" class="credits-line"/>
                    <ui:Label text="Music and sound effects" class="credits-heading"/>
                    <ui:Label text="Epidemic Sound" class="credits-line"/>
                    <ui:Label text="Placeholder gameplay music and effects: synthesized for Verdant Zero" class="credits-line"/>
                    <ui:Label text="Typography" class="credits-heading"/>
                    <ui:Label text="Fredoka, The Fredoka Project Authors" class="credits-line"/>
                    <ui:Label text="SIL Open Font License 1.1" class="credits-line"/>
                    <ui:Label text="Engine" class="credits-heading"/>
                    <ui:Label text="Unity with the Universal Render Pipeline" class="credits-line"/>
                </ui:ScrollView>
                <ui:Button text="BACK" name="btn-credits-back" class="menu-button menu-button--primary panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Level select (GDD 9.3): PLAY opens this panel -->
        <ui:VisualElement name="levels-overlay" class="overlay">
            <ui:VisualElement name="levels-panel" class="panel">
                <ui:Label text="SELECT LEVEL" class="panel-title"/>
                <ui:Button text="1 · VERDANT CITY DOWNTOWN" name="btn-level-1" class="menu-button menu-button--primary level-button"/>
                <ui:Label text="" name="level-1-best" class="level-best"/>
                <ui:Button text="2 · COMING SOON" name="btn-level-2" class="menu-button level-button"/>
                <ui:Button text="3 · COMING SOON" name="btn-level-3" class="menu-button level-button"/>
                <ui:Button text="BACK" name="btn-levels-back" class="menu-button menu-button--ghost panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="fade" picking-mode="Ignore" class="fade"/>
    </ui:VisualElement>
</ui:UXML>
